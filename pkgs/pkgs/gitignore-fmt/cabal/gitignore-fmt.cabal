cabal-version: 3.0
name:          gitignore-fmt
version:       0.1.0
synopsis:      Format whitelist-style gitignore files
license:       MIT
build-type:    Simple

library
  hs-source-dirs:   src
  exposed-modules:
    Gitignore.Cli
    Gitignore.File
    Gitignore.Format

  build-depends:
    , base        >=4.16 && <5
    , bytestring
    , directory
    , filepath
    , unix

  default-language: Haskell2010
  ghc-options:      -Wall

executable gitignore-fmt
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base           >=4.16 && <5
    , gitignore-fmt

  default-language: Haskell2010
  ghc-options:      -Wall

test-suite format-tests
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Format.hs
  other-modules:    Fixtures
  build-depends:
    , base           >=4.16 && <5
    , bytestring
    , gitignore-fmt

  default-language: Haskell2010
  ghc-options:      -Wall

test-suite cli-tests
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Cli.hs
  other-modules:      Fixtures
  build-tool-depends: gitignore-fmt:gitignore-fmt
  build-depends:
    , base           >=4.16 && <5
    , bytestring
    , directory
    , filepath
    , gitignore-fmt
    , process
    , unix

  default-language:   Haskell2010
  ghc-options:        -Wall
